# MCaaS Deployment Environment Variables
# Copy this file to .env and fill in the values before deploying.
#
# If these variables are not set, deploy.py will generate random passwords
# and save them to .env automatically.

# PostgreSQL password — used by:
#   - Bitnami PostgreSQL Helm chart (key: postgres-password)
#   - CISO Assistant (key: password)
#   - Zammad (key: postgres-password)
MCAAS_POSTGRES_PASSWORD=

# OpenSearch password — used by:
#   - OpenSearch Helm chart (key: opensearch-password)
#   - Shuffle backend (key: opensearch-password)
MCAAS_OPENSEARCH_PASSWORD=