# MCaaS Environment Variables
# Copy this file to .env and update the values before running scripts.
# ============================================================

# --- Required ---
# Strong passwords for PostgreSQL and OpenSearch (auto-generated by scripts/deploy.py if left empty)
MCAAS_POSTGRES_PASSWORD=ChangeMe
MCAAS_OPENSEARCH_PASSWORD=ChangeMe

# --- Optional ---
# Redis auth password for Zammad (defaults to 'zammad' if not set)
MCAAS_REDIS_PASSWORD=zammad

# Django secret key for CISO Assistant (auto-generated by scripts/deploy.py if not set)
# MCAAS_DJANGO_SECRET_KEY=

# KUBECONFIG path if you do not use the default kubeconfig location
# KUBECONFIG=~/.kube/config
