# MCaaS Integrations Environment Variables
# Copy this file to .env and fill in the values before running integrations.

# ============================================================================
# Wazuh Configuration
# ============================================================================
WAZUH_NAMESPACE=wazuh
WAZUH_CONFIGMAP_LABELS=app=wazuh,component=manager
# WAZUH_CONFIGMAP_NAME=          # Optional: explicit ConfigMap name

# ============================================================================
# Shuffle SOAR Configuration
# ============================================================================
SHUFFLE_API_URL=http://shuffle-backend.security-ops.svc.cluster.local:5001
# SHUFFLE_API_TOKEN=             # Optional: API authentication token
SHUFFLE_WEBHOOK_URL=http://shuffle-backend.security-ops.svc.cluster.local:5001/api/v1/hooks/webhook_4ec040d0-2ba5-4135-bf69-050cad1d115b
SHUFFLE_ALERT_LEVEL=3

# ============================================================================
# Zammad Configuration
# ============================================================================
ZAMMAD_URL=http://mcaas-zammad-nginx.managed-it.svc.cluster.local:8080
ZAMMAD_API_TOKEN=                # Required for ticket creation
ZAMMAD_GROUP_ID=1
ZAMMAD_CUSTOMER_ID=2

# ============================================================================
# SMTP Configuration (for email notifications)
# ============================================================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=security@mcaas.local
# SOC_EMAIL=soc@mcaas.local

# ============================================================================
# Slack/Teams Configuration
# ============================================================================
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# ============================================================================
# Threat Intelligence Configuration
# ============================================================================
# VT_API_KEY=                    # VirusTotal API key
# ABUSEIPDB_API_KEY=             # AbuseIPDB API key

# ============================================================================
# General Configuration
# ============================================================================
LOG_LEVEL=INFO
TICKET_DEDUPLICATION_WINDOW=24
HEALTH_CHECK_TIMEOUT=30
STATE_FILE=/tmp/wazuh-zammad-state.json
DRY_RUN=false
